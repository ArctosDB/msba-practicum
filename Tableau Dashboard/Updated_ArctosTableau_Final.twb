      <column caption='Color-Blues' datatype='integer' name='[Calculation_2572329503035183104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Blues&quot; THEN COUNT([identification_id]) END' />
      </column>
      <column caption='Color-Reds' datatype='integer' name='[Calculation_2572329503035289601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Reds&quot; THEN COUNT([identification_id]) END' />
      </column>
      <column caption='Color-Greens' datatype='integer' name='[Calculation_2572329503035371522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Greens&quot; THEN COUNT([identification_id]) END' />
      </column>
      <column caption='Color-Purples' datatype='integer' name='[Calculation_2572329503035449347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Purples&quot; THEN COUNT([identification_id]) END' />
      </column>
      <column caption='Tribe caluclate null' datatype='string' name='[Calculation_436567701450391553]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN(ISNULL([tribe])) THEN&#10;    NULL&#10;ELSE&#10;    MIN([tribe])&#10;END' />
      </column>
      <column caption='Theme Color' datatype='string' name='[Calculation_544161557965176838]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;Set1&quot; THEN &quot;Set1_&quot; + STR((INDEX()-1) % 8)&#10;WHEN &quot;Set2&quot; THEN &quot;Set2_&quot; + STR((INDEX()-1) % 8)&#10;WHEN &quot;Pastel2&quot; THEN &quot;Pastel2_&quot; + STR((INDEX()-1) % 8)&#10;WHEN &quot;Dark2&quot; THEN &quot;Dark2_&quot; + STR((INDEX()-1) % 8)&#10;&#10;WHEN &quot;Blues&quot; THEN &quot;Blues_&quot; + STR((INDEX()-1) % 9)&#10;WHEN &quot;Greens&quot; THEN &quot;Greens_&quot; + STR((INDEX()-1) % 9)&#10;WHEN &quot;Reds&quot; THEN &quot;Reds_&quot; + STR((INDEX()-1) % 9)&#10;WHEN &quot;YlOrBr&quot; THEN &quot;YlOrBr_&quot; + STR((INDEX()-1) % 9)&#10;&#10;WHEN &quot;Spectral&quot; THEN &quot;Spectral_&quot; + STR((INDEX()-1) % 8)&#10;WHEN &quot;RdYlBu&quot; THEN &quot;RdYlBu_&quot; + STR((INDEX()-1) % 8)&#10;WHEN &quot;RdYlGn&quot; THEN &quot;RdYlGn_&quot; + STR((INDEX()-1) % 8)&#10;WHEN &quot;PiYG&quot; THEN &quot;PiYG_&quot; + STR((INDEX()-1) % 8)&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color Value' datatype='integer' name='[Calculation_544161557972762634]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;Blues&quot; THEN COUNT([identification_id])&#10;&#10;WHEN &quot;Reds&quot; THEN -COUNT([identification_id])&#10;&#10;END' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_544161557975388171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Show Blues' datatype='boolean' name='[Calculation_780389432487784450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Blues&#10;[Parameters].[Parameter 4] = &quot;Blues&quot;' />
