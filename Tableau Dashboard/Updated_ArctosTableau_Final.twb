                    <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Client: </run>
                    <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Arctos Consortium</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Deliverables: Tableau Dashboard · AI-Powered Querybot · Automated Update Pipeline · Documentation</run>
                    <run>Æ&#10;&#10;</run>
                    <run auto-url='true' fontcolor='#34528f' fontname='Arial' fontsize='16' hyperlink='tabdoc:load-url url=&amp;quot;https://arctos.database.museum&amp;quot;'>https://arctos.database.museum</run>
