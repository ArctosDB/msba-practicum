      <column caption='COLLECTION' datatype='string' name='[Calculation_1629951236337774592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [GUID_PREFIX] in (&apos;UAM:Alg&apos;) then &quot;Algae specimens&quot;&#10;elseif [GUID_PREFIX] in (&apos;BYUObs:Herp&apos;,&#10;&apos;MSBObs:Herp&apos;,&#10;&apos;MVZObs:Herp&apos;,&#10;&apos;UTEPObs:Herp&apos;) then &quot;Amphibian and reptile observations&quot;&#10;elseif [GUID_PREFIX] in (&apos;UTEP:HerpOS&apos;) then &quot;Amphibian and reptile osteology specimens&quot;&#10;elseif [GUID_PREFIX] in (&apos;ACUNHC:Herp&apos;,&#10;&apos;APSU:Herp&apos;,&#10;&apos;ASNHC:Herp&apos;,&#10;&apos;BSUNH:Herp&apos;,&#10;&apos;BYU:Herp&apos;,&#10;&apos;CHAS:Herp&apos;,&#10;&apos;COA:Herp&apos;,&#10;&apos;CRCM:Herp&apos;,&#10;&apos;CSULB:Herp&apos;,&#10;&apos;DMNS:Herp&apos;,&#10;&apos;HMCM:Herp&apos;,&#10;&apos;LINGU:Herp&apos;,&#10;&apos;MSB:Herp&apos;,&#10;&apos;MVZ:Herp&apos;,&#10;&apos;NCWRC:Herp&apos;,&#10;&apos;NMMNH:Herp&apos;,&#10;&apos;NMU:Herp&apos;,&#10;&apos;UAM:Herp&apos;,&#10;&apos;UCM:Herp&apos;,&#10;&apos;UCSC:Herp&apos;,&#10;&apos;UMNH:Herp&apos;,&#10;&apos;UNR:Herp&apos;,&#10;&apos;UTEP:Herp&apos;,&#10;&apos;UWBM:Herp&apos;,&#10;&apos;UWYMV:Herp&apos;,&#10;&apos;UWZM:Herp&apos;,&#10;&apos;ZSFQ:Herp&apos;) then &quot;Amphibian and reptile specimens&quot;&#10;elseif [GUID_PREFIX] in (&apos;OWU:Amph&apos;) then &quot;Amphibian specimens&quot;&#10;elseif [GUID_PREFIX] in (&apos;MVZ:Hild&apos;) then &quot;Anatomical preparations&quot;&#10;elseif [GUID_PREFIX] in (&apos;CHAS:EH&apos;) then &quot;Anthropology, History, and Special Collections&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ASUMZ:Invert&apos;) then &quot;Aquatic macroinvertebrate specimens&quot;&#10;elseif [GUID_PREFIX] in (&apos;NHSM:Arc&apos;,&#10;&apos;UAM:Arc&apos;,&#10;&apos;UTEP:Arc&apos;) then &quot;Archaeology&quot;&#10;elseif [GUID_PREFIX] in (&apos;MVZ:Arch&apos;) then &quot;Archives&quot;&#10;elseif [GUID_PREFIX] in (&apos;CHAS:Art&apos;,&#10;&apos;UAM:Art&apos;) then &quot;Art&quot;&#10;elseif [GUID_PREFIX] in (&apos;MSB:Arth&apos;) then &quot;Arthropod specimens&quot;&#10;ELSEif [GUID_PREFIX] in (&apos;CHAS:AV&apos;) then &quot;Audiovisual materials&quot;&#10;elseif [GUID_PREFIX] in (&apos;UNR:Egg&apos;,&#10;&apos;CHAS:Egg&apos;,&#10;&apos;COA:Egg&apos;,&#10;&apos;DMNS:Egg&apos;,&#10;&apos;MLZ:Egg&apos;,&#10;&apos;MVZ:Egg&apos;,&#10;&apos;UCM:Egg&apos;,&#10;&apos;UWYMV:Egg&apos;) then &quot;Bird eggs&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;KNWRObs:Bird&apos;,&#10;&apos;MVZObs:Bird&apos;,&#10;&apos;UAMObs:Bird&apos;) then &quot;Bird observations&quot;&#10;elseif [GUID_PREFIX] in (&apos;ACUNHC:Bird&apos;,&#10;&apos;ALMNH:Bird&apos;,&#10;&apos;APSU:Bird&apos;,&#10;&apos;ASNHC:Bird&apos;,&#10;&apos;BSUNH:Bird&apos;,&#10;&apos;BYU:Bird&apos;,&#10;&apos;CDSC:Bird&apos;,&#10;&apos;CHAS:Bird&apos;,&#10;&apos;COA:Bird&apos;,&#10;&apos;CRCM:Bird&apos;,&#10;&apos;CSULB:Bird&apos;,&#10;&apos;DMNS:Bird&apos;,&#10;&apos;HMCM:Bird&apos;,&#10;&apos;MLZ:Bird&apos;,&#10;&apos;MMNH:Bird&apos;,&#10;&apos;MSB:Bird&apos;,&#10;&apos;MVZ:Bird&apos;,&#10;&apos;NBSB:Bird&apos;,&#10;&apos;NHSM:Bird&apos;,&#10;&apos;NMMNH:Bird&apos;,&#10;&apos;NMU:Bird&apos;,&#10;&apos;OWU:Bird&apos;,&#10;&apos;UAM:Bird&apos;,&#10;&apos;UCM:Bird&apos;,&#10;&apos;UCSC:Bird&apos;,&#10;&apos;UMNH:Bird&apos;,&#10;&apos;UMZM:Bird&apos;,&#10;&apos;UNR:Bird&apos;,&#10;&apos;UTEP:Bird&apos;,&#10;&apos;UWYMV:Bird&apos;,&#10;&apos;UWZM:Bird&apos;,&#10;&apos;WNMU:Bird&apos;) then &quot;Bird Specimen&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ASUMZ:Bivalve&apos;) then &quot;Bivalve Specimen&quot; &#10;ELSEIF [GUID_PREFIX] in (&apos;UAMb:Herb&apos;) then &quot;Cryptogam specimens (ALA)&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;BIOAPT:LEGECC&apos;) then &quot;Cyanobacteria and Microalgae&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UAM:HerbLib&apos;) then &quot;Documents&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UAM:ES&apos;,&#10;&apos;UNM:Paleo&apos;,&#10;&apos;UTEP:ES&apos;) then &quot;Earth Science&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UMZM:Egg&apos;,&#10;&apos;JSNM:Egg&apos;) then &quot;Egg specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;Arctos:Entity&apos;) then &quot;Entity&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;KNWR:Env&apos;,&#10;&apos;UAM:Env&apos;) then &quot;Environmental samples&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UAM:EH&apos;) then &quot;Ethnology and History objects&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;KNWRObs:Fish&apos;,&#10;&apos;MLZObs:Fish&apos;,&#10;&apos;UAMObs:Fish&apos;) then &quot;Fish Observation&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ACUNHC:Fish&apos;,&#10;&apos;APSU:Fish&apos;,&#10;&apos;ASUMZ:Fish&apos;,&#10;&apos;BYU:Fish&apos;,&#10;&apos;CHAS:Fish&apos;,&#10;&apos;CRCM:Fish&apos;,&#10;&apos;CSULB:Fish&apos;,&#10;&apos;JFBM:Fish&apos;,&#10;&apos;MLZ:Fish&apos;,&#10;&apos;MSB:Fish&apos;,&#10;&apos;MVZ:Fish&apos;,&#10;&apos;NCWRC:Fish&apos;,&#10;&apos;NMMNH:Fish&apos;,&#10;&apos;OWU:Fish&apos;,&#10;&apos;UAM:Fish&apos;,&#10;&apos;UCM:Fish&apos;,&#10;&apos;UNR:Fish&apos;,&#10;&apos;UTEP:Fish&apos;,&#10;&apos;UWYMV:Fish&apos;,&#10;&apos;WNMU:Fish&apos;) then &quot;Fish&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UCM:FossilEgg&apos;,&#10;&apos;ACUNHC:Paleo&apos;,&#10;&apos;CRCM:Paleo&apos;,&#10;&apos;JSNM:Paleo&apos;,&#10;&apos;UCM:FossilTrack&apos;,&#10;&apos;UCM:FossilVert&apos;) then &quot;Fossil Specimen&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UAM:Myco&apos;) then &quot;Fungus Specimen&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;MSB:DGR&apos;,&#10;&apos;OGL:Genomic&apos;) then &quot;Genomic samples&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ALMNH:Geo&apos;,&#10;&apos;HMCM:Geo&apos;,&#10;&apos;NHSM:Geol&apos;,&#10;&apos;NMMNH:Geol&apos;,&#10;&apos;TCDGM:Rock&apos;,&#10;&apos;UNM:Geol&apos;) then &quot;Geology specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;HMCM:Herb&apos;,&#10;&apos;JSNM:Herb&apos;,&#10;&apos;NMMNH:Herb&apos;,&#10;&apos;TMCC:Herb&apos;) then &quot;Herbarium specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ALMNH:EH&apos;) then &quot;History and Ethnology&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;MSB:Host&apos;,&#10;&apos;ANSP:Host&apos;) then &quot;Host Observations&quot;&#10;elseif [GUID_PREFIX] in (&apos;UAMObs:Ento&apos;,&#10;&apos;UTEPObs:Ento&apos;) then &quot;Insect observations&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ACUNHC:Ento&apos;,&#10;&apos;ALMNH:Ento&apos;,&#10;&apos;ASUMZ:Ento&apos;,&#10;&apos;CHAS:Ento&apos;,&#10;&apos;COA:Ento&apos;,&#10;&apos;KNWR:Ento&apos;,&#10;&apos;NMMNH:Ento&apos;,&#10;&apos;UAA:Ento&apos;,&#10;&apos;UAM:Ento&apos;,&#10;&apos;UTEP:Ento&apos;) then &quot;Insect specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;HMCM:Arthro&apos;,&#10;&apos;KNWR:Inv&apos;,&#10;&apos;MSB:Inv&apos;,&#10;&apos;NMMNH:Inv&apos;,&#10;&apos;OWU:Inv&apos;,&#10;&apos;UAM:Inv&apos;,&#10;&apos;UTEP:Inv&apos;) then &quot;Invertebrate specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ALMNH:Inv&apos;) then &quot;Invertebrate Zoology&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;KWP:Ento&apos;) then &quot;Lepidopteran specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;KNWRObs:Mamm&apos;,&#10;&apos;MSBObs:Mamm&apos;,&#10;&apos;MVZObs:Mamm&apos;,&#10;&apos;UAMObs:Mamm&apos;) then &quot;Mammal Observations&quot;&#10;elseif [GUID_PREFIX] in (&apos;UNCG:Mamm&apos;,&apos;ACUNHC:Mamm&apos;,&#10;&apos;ALMNH:Mamm&apos;,&#10;&apos;APSU:Mamm&apos;,&#10;&apos;ASNHC:Mamm&apos;,&#10;&apos;ASUMZ:Mamm&apos;,&#10;&apos;BSUNH:Mamm&apos;,&#10;&apos;BYU:Mamm&apos;,&#10;&apos;CDSC:Mamm&apos;,&#10;&apos;CHAS:Mamm&apos;,&#10;&apos;COA:Mamm&apos;,&#10;&apos;CRCM:Mamm&apos;,&#10;&apos;CSULB:Mamm&apos;,&#10;&apos;DMNS:Mamm&apos;,&#10;&apos;HMCM:Mamm&apos;,&#10;&apos;HSUVM:Mamm&apos;,&#10;&apos;KSB:Mamm&apos;,&#10;&apos;MLZ:Mamm&apos;,&#10;&apos;MMNH:Mamm&apos;,&#10;&apos;MSB:Mamm&apos;,&#10;&apos;MVZ:Mamm&apos;,&#10;&apos;NCWRC:Mamm&apos;,&#10;&apos;NHSM:Mamm&apos;,&#10;&apos;NMMNH:Mamm&apos;,&#10;&apos;NMU:Mamm&apos;,&#10;&apos;OWU:Mamm&apos;,&#10;&apos;UAM:Mamm&apos;,&#10;&apos;UCM:Mamm&apos;,&#10;&apos;UCSC:Mamm&apos;,&#10;&apos;UMNH:Mamm&apos;,&#10;&apos;UMZM:Mamm&apos;,&#10;&apos;UNR:Mamm&apos;,&#10;&apos;UTEP:Mamm&apos;,&#10;&apos;UWBM:Mamm&apos;,&#10;&apos;UWYMV:Mamm&apos;,&#10;&apos;UWZM:Mamm&apos;,&#10;&apos;WNMU:Mamm&apos;) then &quot;Mammal specimens&quot;&#10;elseif [GUID_PREFIX] in (&apos;ACUNHC:Inv&apos;,&#10;&apos;DMNS:Inv&apos;) then &quot;Marine invertebrate specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UNM:MET&apos;) then &quot;Meteoritics&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;TCDGM:Mineral&apos;) then &quot;Mineral specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;CHAS:Inv&apos;) then &quot;Mollusc specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;BIOAPT:CMCC&apos;) then &quot;Non-photosynthetic microorganisms (Cryopreserved)&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;NMMNH:Obs&apos;) then &quot;Observations&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UWBM:PR&apos;) then &quot;Paleobotany Reference specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UWBM:PB&apos;) then &quot;Paleobotany specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;ALMNH:Paleo&apos;,&#10;&apos;NMMNH:Paleo&apos;,&#10;&apos;OWU:ES&apos;,&#10;&apos;PSM:Paleo&apos;,&#10;&apos;TCDGM:Paleo&apos;,&#10;&apos;UA:Paleo&apos;) then &quot;Paleontology specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UNCG:Para&apos;,&#10;&apos;ANSP:Para&apos;,&#10;&apos;DMNS:Para&apos;,&#10;&apos;HWML:Para&apos;,&#10;&apos;MSB:Para&apos;,&#10;&apos;NMU:Para&apos;,&#10;&apos;OWU:Para&apos;,&#10;&apos;UCM:Para&apos;,&#10;&apos;UMNH:Para&apos;,&#10;&apos;UMZM:Para&apos;,&#10;&apos;USNPC:Para&apos;) then &quot;Parasite Collection&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;KNWRObs:Herb&apos;,&#10;&apos;CHAS:Herb&apos;,&#10;&apos;KNWR:Herb&apos;,&#10;&apos;MLZ:Herb&apos;,&#10;&apos;UTEP:Herb&apos;,&#10;&apos;UAM:Herb&apos;) then &quot;Plant Specimen&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;OWU:Rept&apos;) then &quot;Reptile specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;BIOAPT:DEEPBB&apos;) then &quot;Sponges and Coral Specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;BYU:Edu&apos;,&#10;&apos;MMNH:Edu&apos;,&#10;&apos;UMNH:Teach&apos;,&#10;&apos;BYU:Teach&apos;,&#10;&apos;CHAS:Teach&apos;,&#10;&apos;KSB:Teach&apos;,&#10;&apos;UTEP:Teach&apos;) then &quot;Teaching and Education specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UCM:Obs&apos;,&#10;&apos;UWBM:VP&apos;) then &quot;Vertebrate observations&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UAF:Zooarch&apos;) then &quot;Zooarchaeological comparative specimens&quot;&#10;ELSEIF [GUID_PREFIX] in (&apos;UTEP:Zoo&apos;) then &quot;Zooplankton specimens&quot;&#10;end' />
      </column>
      <column caption='Type' datatype='string' name='[Calculation_3000945485248167936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [GUID_PREFIX] in (&quot;ACUNHC:Bird&quot;,&#10;&quot;ACUNHC:Ento&quot;,&#10;&quot;ACUNHC:Fish&quot;,&#10;&quot;ACUNHC:Herp&quot;,&#10;&quot;ACUNHC:Inv&quot;,&#10;&quot;ACUNHC:Mamm&quot;,&#10;&quot;ACUNHC:Paleo&quot;,&#10;&quot;ALMNH:Bird&quot;,&#10;&quot;ALMNH:Ento&quot;,&#10;&quot;ALMNH:Herp&quot;,&#10;&quot;ALMNH:Inv&quot;,&#10;&quot;ALMNH:Mamm&quot;,&#10;&quot;ALMNH:Paleo&quot;,&#10;&quot;ANSP:Host&quot;,&#10;&quot;ANSP:Para&quot;,&#10;&quot;APSU:Bird&quot;,&#10;&quot;APSU:Fish&quot;,&#10;&quot;APSU:Herp&quot;,&#10;&quot;APSU:Mamm&quot;,&#10;&quot;ASNHC:Bird&quot;,&#10;&quot;ASNHC:Herb&quot;,&#10;&quot;ASNHC:Herp&quot;,&#10;&quot;ASNHC:Mamm&quot;,&#10;&quot;ASNHC:Para&quot;,&#10;&quot;ASUMZ:Bird&quot;,&#10;&quot;ASUMZ:Bivalve&quot;,&#10;&quot;ASUMZ:Ento&quot;,&#10;&quot;ASUMZ:Fish&quot;,&#10;&quot;ASUMZ:Herp&quot;,&#10;&quot;ASUMZ:Invert&quot;,&#10;&quot;ASUMZ:Mamm&quot;,&#10;&quot;BIOAPT:LEGECC&quot;,&#10;&quot;BIOAPT:UABB&quot;,&#10;&quot;BSUNH:Bird&quot;,&#10;&quot;BSUNH:Fish&quot;,&#10;&quot;BSUNH:Herb&quot;,&#10;&quot;BSUNH:Herp&quot;,&#10;&quot;BSUNH:Inv&quot;,&#10;&quot;BSUNH:Mamm&quot;,&#10;&quot;BYU:Bird&quot;,&#10;&quot;BYU:Edu&quot;,&#10;&quot;BYU:Fish&quot;,&#10;&quot;BYU:Herp&quot;,&#10;&quot;BYU:Mamm&quot;,&#10;&quot;BYU:Teach&quot;,&#10;&quot;BYUObs:Bird&quot;,&#10;&quot;BYUObs:Herp&quot;,&#10;&quot;BYUObs:Mamm&quot;,&#10;&quot;CDSC:Bird&quot;,&#10;&quot;CDSC:Ento&quot;,&#10;&quot;CDSC:Herb&quot;,&#10;&quot;CDSC:Herp&quot;,&#10;&quot;CDSC:Inv&quot;,&#10;&quot;CDSC:Mamm&quot;,&#10;&quot;CHAS:Bird&quot;,&#10;&quot;CHAS:Egg&quot;,&#10;&quot;CHAS:Ento&quot;,&#10;&quot;CHAS:ES&quot;,&#10;&quot;CHAS:Fish&quot;,&#10;&quot;CHAS:Herb&quot;,&#10;&quot;CHAS:Herp&quot;,&#10;&quot;CHAS:Inv&quot;,&#10;&quot;CHAS:Mamm&quot;,&#10;&quot;CHAS:Teach&quot;,&#10;&quot;COA:Bird&quot;,&#10;&quot;COA:Egg&quot;,&#10;&quot;COA:Ento&quot;,&#10;&quot;COA:Herp&quot;,&#10;&quot;COA:Mamm&quot;,&#10;&quot;COA:Rept&quot;,&#10;&quot;