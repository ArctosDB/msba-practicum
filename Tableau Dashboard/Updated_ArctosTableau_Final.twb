 [Guid_Prefix] in (&apos;MSB:Host&apos;,&#10;&apos;ANSP:Host&apos;) then &quot;Host Observations&quot;&#10;elseif [Guid_Prefix] in (&apos;UAMObs:Ento&apos;,&#10;&apos;UTEPObs:Ento&apos;) then &quot;Insect observations&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;ACUNHC:Ento&apos;,&#10;&apos;ALMNH:Ento&apos;,&#10;&apos;ASUMZ:Ento&apos;,&#10;&apos;CHAS:Ento&apos;,&#10;&apos;COA:Ento&apos;,&#10;&apos;KNWR:Ento&apos;,&#10;&apos;NMMNH:Ento&apos;,&#10;&apos;UAA:Ento&apos;,&#10;&apos;UAM:Ento&apos;,&#10;&apos;UTEP:Ento&apos;) then &quot;Insect specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;HMCM:Arthro&apos;,&#10;&apos;KNWR:Inv&apos;,&#10;&apos;MSB:Inv&apos;,&#10;&apos;NMMNH:Inv&apos;,&#10;&apos;OWU:Inv&apos;,&#10;&apos;UAM:Inv&apos;,&#10;&apos;UTEP:Inv&apos;) then &quot;Invertebrate specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;ALMNH:Inv&apos;) then &quot;Invertebrate Zoology&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;KWP:Ento&apos;) then &quot;Lepidopteran specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;KNWRObs:Mamm&apos;,&#10;&apos;MSBObs:Mamm&apos;,&#10;&apos;MVZObs:Mamm&apos;,&#10;&apos;UAMObs:Mamm&apos;) then &quot;Mammal Observations&quot;&#10;elseif [Guid_Prefix] in (&apos;UNCG:Mamm&apos;,&apos;ACUNHC:Mamm&apos;,&#10;&apos;ALMNH:Mamm&apos;,&#10;&apos;APSU:Mamm&apos;,&#10;&apos;ASNHC:Mamm&apos;,&#10;&apos;ASUMZ:Mamm&apos;,&#10;&apos;BSUNH:Mamm&apos;,&#10;&apos;BYU:Mamm&apos;,&#10;&apos;CDSC:Mamm&apos;,&#10;&apos;CHAS:Mamm&apos;,&#10;&apos;COA:Mamm&apos;,&#10;&apos;CRCM:Mamm&apos;,&#10;&apos;CSULB:Mamm&apos;,&#10;&apos;DMNS:Mamm&apos;,&#10;&apos;HMCM:Mamm&apos;,&#10;&apos;HSUVM:Mamm&apos;,&#10;&apos;KSB:Mamm&apos;,&#10;&apos;MLZ:Mamm&apos;,&#10;&apos;MMNH:Mamm&apos;,&#10;&apos;MSB:Mamm&apos;,&#10;&apos;MVZ:Mamm&apos;,&#10;&apos;NCWRC:Mamm&apos;,&#10;&apos;NHSM:Mamm&apos;,&#10;&apos;NMMNH:Mamm&apos;,&#10;&apos;NMU:Mamm&apos;,&#10;&apos;OWU:Mamm&apos;,&#10;&apos;UAM:Mamm&apos;,&#10;&apos;UCM:Mamm&apos;,&#10;&apos;UCSC:Mamm&apos;,&#10;&apos;UMNH:Mamm&apos;,&#10;&apos;UMZM:Mamm&apos;,&#10;&apos;UNR:Mamm&apos;,&#10;&apos;UTEP:Mamm&apos;,&#10;&apos;UWBM:Mamm&apos;,&#10;&apos;UWYMV:Mamm&apos;,&#10;&apos;UWZM:Mamm&apos;,&#10;&apos;WNMU:Mamm&apos;) then &quot;Mammal specimens&quot;&#10;elseif [Guid_Prefix] in (&apos;ACUNHC:Inv&apos;,&#10;&apos;DMNS:Inv&apos;) then &quot;Marine invertebrate specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UNM:MET&apos;) then &quot;Meteoritics&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;TCDGM:Mineral&apos;) then &quot;Mineral specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;CHAS:Inv&apos;) then &quot;Mollusc specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;BIOAPT:CMCC&apos;) then &quot;Non-photosynthetic microorganisms (Cryopreserved)&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;NMMNH:Obs&apos;) then &quot;Observations&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UWBM:PR&apos;) then &quot;Paleobotany Reference specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UWBM:PB&apos;) then &quot;Paleobotany specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;ALMNH:Paleo&apos;,&#10;&apos;NMMNH:Paleo&apos;,&#10;&apos;OWU:ES&apos;,&#10;&apos;PSM:Paleo&apos;,&#10;&apos;TCDGM:Paleo&apos;,&#10;&apos;UA:Paleo&apos;) then &quot;Paleontology specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UNCG:Para&apos;,&#10;&apos;ANSP:Para&apos;,&#10;&apos;DMNS:Para&apos;,&#10;&apos;HWML:Para&apos;,&#10;&apos;MSB:Para&apos;,&#10;&apos;NMU:Para&apos;,&#10;&apos;OWU:Para&apos;,&#10;&apos;UCM:Para&apos;,&#10;&apos;UMNH:Para&apos;,&#10;&apos;UMZM:Para&apos;,&#10;&apos;USNPC:Para&apos;) then &quot;Parasite Collection&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;KNWRObs:Herb&apos;,&#10;&apos;CHAS:Herb&apos;,&#10;&apos;KNWR:Herb&apos;,&#10;&apos;MLZ:Herb&apos;,&#10;&apos;UTEP:Herb&apos;,&#10;&apos;UAM:Herb&apos;) then &quot;Plant Specimen&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;OWU:Rept&apos;) then &quot;Reptile specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;BIOAPT:DEEPBB&apos;) then &quot;Sponges and Coral Specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;BYU:Edu&apos;,&#10;&apos;MMNH:Edu&apos;,&#10;&apos;UMNH:Teach&apos;,&#10;&apos;BYU:Teach&apos;,&#10;&apos;CHAS:Teach&apos;,&#10;&apos;KSB:Teach&apos;,&#10;&apos;UTEP:Teach&apos;) then &quot;Teaching and Education specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UCM:Obs&apos;,&#10;&apos;UWBM:VP&apos;) then &quot;Vertebrate observations&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UAF:Zooarch&apos;) then &quot;Zooarchaeological comparative specimens&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UTEP:Zoo&apos;) then &quot;Zooplankton specimens&quot;&#10;end' />
      </column>
