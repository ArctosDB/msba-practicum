        <calculation class='tableau' formula='if [Guid_Prefix] in (&apos;UAM:Alg&apos;) then &quot;Algae specimens&quot;&#10;elseif [Guid_Prefix] in (&apos;BYUObs:Herp&apos;,&#10;&apos;MSBObs:Herp&apos;,&#10;&apos;MVZObs:Herp&apos;,&#10;&apos;UTEPObs:Herp&apos;) then &quot;Amphibian and reptile observations&quot;&#10;elseif [Guid_Prefix] in (&apos;UTEP:HerpOS&apos;) then &quot;Amphibian and reptile osteology specimens&quot;&#10;elseif [Guid_Prefix] in (&apos;ACUNHC:Herp&apos;,&#10;&apos;APSU:Herp&apos;,&#10;&apos;ASNHC:Herp&apos;,&#10;&apos;BSUNH:Herp&apos;,&#10;&apos;BYU:Herp&apos;,&#10;&apos;CHAS:Herp&apos;,&#10;&apos;COA:Herp&apos;,&#10;&apos;CRCM:Herp&apos;,&#10;&apos;CSULB:Herp&apos;,&#10;&apos;DMNS:Herp&apos;,&#10;&apos;HMCM:Herp&apos;,&#10;&apos;LINGU:Herp&apos;,&#10;&apos;MSB:Herp&apos;,&#10;&apos;MVZ:Herp&apos;,&#10;&apos;NCWRC:Herp&apos;,&#10;&apos;NMMNH:Herp&apos;,&#10;&apos;NMU:Herp&apos;,&#10;&apos;UAM:Herp&apos;,&#10;&apos;UCM:Herp&apos;,&#10;&apos;UCSC:Herp&apos;,&#10;&apos;UMNH:Herp&apos;,&#10;&apos;UNR:Herp&apos;,&#10;&apos;UTEP:Herp&apos;,&#10;&apos;UWBM:Herp&apos;,&#10;&apos;UWYMV:Herp&apos;,&#10;&apos;UWZM:Herp&apos;,&#10;&apos;ZSFQ:Herp&apos;) then &quot;Amphibian and reptile specimens&quot;&#10;elseif [Guid_Prefix] in (&apos;OWU:Amph&apos;) then &quot;Amphibian specimens&quot;&#10;elseif [Guid_Prefix] in (&apos;MVZ:Hild&apos;) then &quot;Anatomical preparations&quot;&#10;elseif [Guid_Prefix] in (&apos;CHAS:EH&apos;) then &quot;Anthropology, History, and Special Collections&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;ASUMZ:Invert&apos;) then &quot;Aquatic macroinvertebrate specimens&quot;&#10;elseif [Guid_Prefix] in (&apos;NHSM:Arc&apos;,&#10;&apos;UAM:Arc&apos;,&#10;&apos;UTEP:Arc&apos;) then &quot;Archaeology&quot;&#10;elseif [Guid_Prefix] in (&apos;MVZ:Arch&apos;) then &quot;Archives&quot;&#10;elseif [Guid_Prefix] in (&apos;CHAS:Art&apos;,&#10;&apos;UAM:Art&apos;) then &quot;Art&quot;&#10;elseif [Guid_Prefix] in (&apos;MSB:Arth&apos;) then &quot;Arthropod specimens&quot;&#10;ELSEif [Guid_Prefix] in (&apos;CHAS:AV&apos;) then &quot;Audiovisual materials&quot;&#10;elseif [Guid_Prefix] in (&apos;UNR:Egg&apos;,&#10;&apos;CHAS:Egg&apos;,&#10;&apos;COA:Egg&apos;,&#10;&apos;DMNS:Egg&apos;,&#10;&apos;MLZ:Egg&apos;,&#10;&apos;MVZ:Egg&apos;,&#10;&apos;UCM:Egg&apos;,&#10;&apos;UWYMV:Egg&apos;) then &quot;Bird eggs&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;KNWRObs:Bird&apos;,&#10;&apos;MVZObs:Bird&apos;,&#10;&apos;UAMObs:Bird&apos;) then &quot;Bird observations&quot;&#10;elseif [Guid_Prefix] in (&apos;ACUNHC:Bird&apos;,&#10;&apos;ALMNH:Bird&apos;,&#10;&apos;APSU:Bird&apos;,&#10;&apos;ASNHC:Bird&apos;,&#10;&apos;BSUNH:Bird&apos;,&#10;&apos;BYU:Bird&apos;,&#10;&apos;CDSC:Bird&apos;,&#10;&apos;CHAS:Bird&apos;,&#10;&apos;COA:Bird&apos;,&#10;&apos;CRCM:Bird&apos;,&#10;&apos;CSULB:Bird&apos;,&#10;&apos;DMNS:Bird&apos;,&#10;&apos;HMCM:Bird&apos;,&#10;&apos;MLZ:Bird&apos;,&#10;&apos;MMNH:Bird&apos;,&#10;&apos;MSB:Bird&apos;,&#10;&apos;MVZ:Bird&apos;,&#10;&apos;NBSB:Bird&apos;,&#10;&apos;NHSM:Bird&apos;,&#10;&apos;NMMNH:Bird&apos;,&#10;&apos;NMU:Bird&apos;,&#10;&apos;OWU:Bird&apos;,&#10;&apos;UAM:Bird&apos;,&#10;&apos;UCM:Bird&apos;,&#10;&apos;UCSC:Bird&apos;,&#10;&apos;UMNH:Bird&apos;,&#10;&apos;UMZM:Bird&apos;,&#10;&apos;UNR:Bird&apos;,&#10;&apos;UTEP:Bird&apos;,&#10;&apos;UWYMV:Bird&apos;,&#10;&apos;UWZM:Bird&apos;,&#10;&apos;WNMU:Bird&apos;) then &quot;Bird Specimen&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;ASUMZ:Bivalve&apos;) then &quot;Bivalve Specimen&quot; &#10;ELSEIF [Guid_Prefix] in (&apos;UAMb:Herb&apos;) then &quot;Cryptogam specimens (ALA)&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;BIOAPT:LEGECC&apos;) then &quot;Cyanobacteria and Microalgae&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UAM:HerbLib&apos;) then &quot;Documents&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UAM:ES&apos;,&#10;&apos;UNM:Paleo&apos;,&#10;&apos;UTEP:ES&apos;) then &quot;Earth Science&quot;&#10;ELSEIF [Guid_Prefix] in (&apos;UMZM:Egg&apos;,&#10;&apos;