                <zone fixed-size='160' forceUpdate='true' h='14600' id='154' type-v2='text' w='91025' x='8340' y='85000'>
                  <formatted-text>
                    <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Developed by the UC Davis MSBA Practicum team (2025-2026) for the Arctos Consortium / Museum of Vertebrate Zoology.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Authors: </run>
                    <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Abdurrahman Kazi, Qianying Yang</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Academic Advisor: </run>
                    <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Michelle S. Koo</run>
