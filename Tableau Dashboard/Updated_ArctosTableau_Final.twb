        <calculation class='tableau' formula='if [F4] in (&apos;UAM:Alg&apos;) then &quot;Algae specimens&quot;&#10;elseif [F4] in (&apos;BYUObs:Herp&apos;,&#10;&apos;MSBObs:Herp&apos;,&#10;&apos;MVZObs:Herp&apos;,&#10;&apos;UTEPObs:Herp&apos;) then &quot;Amphibian and reptile observations&quot;&#10;elseif [F4] in (&apos;UTEP:HerpOS&apos;) then &quot;Amphibian and reptile osteology specimens&quot;&#10;elseif [F4] in (&apos;ACUNHC:Herp&apos;,&#10;&apos;APSU:Herp&apos;,&#10;&apos;ASNHC:Herp&apos;,&#10;&apos;BSUNH:Herp&apos;,&#10;&apos;BYU:Herp&apos;,&#10;&apos;CHAS:Herp&apos;,&#10;&apos;COA:Herp&apos;,&#10;&apos;CRCM:Herp&apos;,&#10;&apos;CSULB:Herp&apos;,&#10;&apos;DMNS:Herp&apos;,&#10;&apos;HMCM:Herp&apos;,&#10;&apos;LINGU:Herp&apos;,&#10;&apos;MSB:Herp&apos;,&#10;&apos;MVZ:Herp&apos;,&#10;&apos;NCWRC:Herp&apos;,&#10;&apos;NMMNH:Herp&apos;,&#10;&apos;NMU:Herp&apos;,&#10;&apos;UAM:Herp&apos;,&#10;&apos;UCM:Herp&apos;,&#10;&apos;UCSC:Herp&apos;,&#10;&apos;UMNH:Herp&apos;,&#10;&apos;UNR:Herp&apos;,&#10;&apos;UTEP:Herp&apos;,&#10;&apos;UWBM:Herp&apos;,&#10;&apos;UWYMV:Herp&apos;,&#10;&apos;UWZM:Herp&apos;,&#10;&apos;ZSFQ:Herp&apos;) then &quot;Amphibian and reptile specimens&quot;&#10;elseif [F4] in (&apos;OWU:Amph&apos;) then &quot;Amphibian specimens&quot;&#10;elseif [F4] in (&apos;MVZ:Hild&apos;) then &quot;Anatomical preparations&quot;&#10;elseif [F4] in (&apos;CHAS:EH&apos;) then &quot;Anthropology, History, and Special Collections&quot;&#10;ELSEIF [F4] in (&apos;ASUMZ:Invert&apos;) then &quot;Aquatic macroinvertebrate specimens&quot;&#10;elseif [F4] in (&apos;NHSM:Arc&apos;,&#10;&apos;UAM:Arc&apos;,&#10;&apos;UTEP:Arc&apos;) then &quot;Archaeology&quot;&#10;elseif [F4] in (&apos;MVZ:Arch&apos;) then &quot;Archives&quot;&#10;elseif [F4] in (&apos;CHAS:Art&apos;,&#10;&apos;UAM:Art&apos;) then &quot;Art&quot;&#10;elseif [F4] in (&apos;MSB:Arth&apos;) then &quot;Arthropod specimens&quot;&#10;ELSEif [F4] in (&apos;CHAS:AV&apos;) then &quot;Audiovisual materials&quot;&#