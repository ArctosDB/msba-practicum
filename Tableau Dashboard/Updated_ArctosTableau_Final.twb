      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Times New Roman' fontsize='26'>ARCTOS CONSORTIUM</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/Arctos/ReadMe?rev=' id='111694484' path='/workbooks/Arctos' revision='' />
      <style />
      <size maxheight='2000' maxwidth='1259' minheight='2000' minwidth='1259' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99200' id='149' param='vert' type-v2='layout-flow' w='98730' x='635' y='400'>
            <zone fixed-size='64' h='3200' id='150' is-fixed='true' type-v2='title' w='98730' x='635' y='400'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='0' />
                <format attr='background-color' value='#003b64' />
              </zone-style>
            </zone>
            <zone h='96000' id='147' type-v2='layout-basic' w='98730' x='635' y='3600'>
              <zone h='95376' id='145' param='vert' type-v2='layout-flow' w='98730' x='635' y='4224'>
                <zone h='95376' id='143' type-v2='layout-basic' w='98730' x='635' y='4224'>
                  <zone h='95376' id='11' param='horz' type-v2='layout-flow' w='91025' x='8340' y='4224'>
                    <zone h='95376' id='5' param='vert' type-v2='layout-flow' w='91025' x='8340' y='4224'>
                      <zone fixed-size='10' h='500' id='151' is-fixed='true' param='horz' type-v2='layout-flow' w='91025' x='8340' y='4224' />
                      <zone fixed-size='51' h='2550' id='152' is-fixed='true' param='horz' type-v2='layout-flow' w='91025' x='8340' y='4724'>
                        <zone forceUpdate='true' h='2550' id='153' type-v2='text' w='91025' x='8340' y='4724'>
                          <formatted-text>
                            <run bold='true' fontcolor='#34528f' fontname='Tableau Regular' fontsize='26'>1.  SUMMARY DASHBOARD</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                      </zone>
                      <zone fixed-size='709' h='30376' id='157' is-fixed='true' param='vert' type-v2='layout-flow' w='91025' x='8340' y='7274'>
                        <zone fixed-size='217' forceUpdate='true' h='11250' id='158' is-fixed='true' type-v2='text' w='91025' x='8340' y='7274'>
                          <formatted-text>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>High-level overview of the entire Arctos collection, showing record distribution across institutions and live database statistics.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Portal Distribution Bar Chart</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>: Number of records per GUID Prefix, sorted by count. Use the filters on the right (Institution, Type, Portal Name, Collection) to narrow the view.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>% Distribution Pie Chart</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>: Proportional share of each institution&apos;s records. Hover over a slice to see the exact percentage and collection name.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>System Statistics</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>: Live database counts — Catalog Records, Taxa, Taxon Relations, Localities, Geo-ref Localities, Collecting Events, Agents, GenBank, Publications, Projects, and Media.</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                        <zone forceUpdate='true' h='19126' id='366' type-v2='text' w='91025' x='8340' y='18524'>
                          <formatted-text>
                            <run bold='true' fontcolor='#34528f' fontname='Tableau Regular' fontsize='12'>GLOSSARY</run>
                            <run fontcolor='#34528f' fontname='Tableau Regular' fontsize='12'> : </run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>1. Biodiversity (Taxonomy &amp; Specimen Data)</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>This category includes the biological classification and relationships of specimens, as well as the specific details about each organism.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Records</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Entries representing individual specimens or observations, including relevant metadata.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Taxa</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: The classification of organisms (e.g., species, genus) used to categorize biodiversity.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Taxa Relations</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Relationships between taxa, like genus-species or ecological associations.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>2. Collection Context (Geography &amp; Collecting Context)</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>This category covers the geographic and environmental information about specimen collection.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Localities</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Geographic locations where specimens were collected or observed.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Geo-ref Localities</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Localities with precise geographic coordinates (latitude and longitude).</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Collecting Events</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Details of the specimen collection, including date, collector, and method.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>3. Research &amp; Media (Project, Publication, and Media Data)</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>This category includes research projects, publications, and media associated with specimens.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Project</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: The research study or initiative under which specimens were collected.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Agent</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Individuals or organizations involved in collecting or researching specimens.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>GenBank</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: A database of genetic sequences for specimens.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='12'>Publications</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>: Research papers or articles in which specimens are mentioned or cited.</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                      </zone>
                      <zone fixed-size='103' h='5150' id='160' is-fixed='true' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='91025' x='8340' y='37650'>
                        <zone forceUpdate='true' h='5150' id='161' type-v2='text' w='91025' x='8340' y='37650'>
                          <formatted-text>
                            <run bold='true' fontcolor='#34528f' fontname='Tableau Regular' fontsize='26'>2.  SPATIAL ANALYSIS</run>
                            <run>Æ&#10;&#10;</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='12'>Interactive map showing the geographic distribution of Arctos specimen records worldwide. This dashboard has three main components:</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                      </zone>
                      <zone fixed-size='420' h='21000' id='162' is-fixed='true' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='91025' x='8340' y='42800'>
                        <zone fixed-size='1138' forceUpdate='true' h='7000' id='164' is-fixed='true' type-v2='text' w='91025' x='8340' y='42800'>
                          <formatted-text>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Map</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Each point represents a specimen location, color-coded by Year Collected (pre-1900, 1900–1949, 1950–1999, 2000–present). Click any region to cross-filter the bar charts.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Filters (right panel)</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Narrow records by GUID Prefix, Collection Type, Kingdom, and Country Selection.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Bar Charts</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Show record counts by GUID Prefix within the current filtered view. Click a bar to highlight those records on the map.</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                            <format attr='margin-bottom' value='0' />
                          </zone-style>
                        </zone>
                        <zone fixed-size='50' h='7000' id='165' is-fixed='true' param='horz' type-v2='layout-flow' w='91025' x='8340' y='49800'>
                          <zone forceUpdate='true' h='7000' id='166' type-v2='text' w='91025' x='8340' y='49800'>
                            <formatted-text>
                              <run bold='true' fontcolor='#34528f' fontname='Tableau Regular' fontsize='26'>3.  TAXONOMIC BREAKDOWN</run>
                              <run>Æ&#10;&#10;</run>
                              <run fontcolor='#34528f' fontname='Arial' fontsize='12'>Detailed record counts across the full taxonomic hierarchy for all Arctos collections. Drill down from collection type all the way to species level.</run>
                            </formatted-text>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                              <format attr='margin-top' value='0' />
                            </zone-style>
                          </zone>
                        </zone>
                        <zone h='7000' id='174' param='horz' type-v2='layout-flow' w='91025' x='8340' y='56800'>
                          <zone forceUpdate='true' h='7000' id='172' type-v2='text' w='91025' x='8340' y='56800'>
                            <formatted-text>
                              <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Rows</run>
                              <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Organized by Collection Type (e.g., Mammalogy, Ornithology, Cultural) with GUID Prefix as the sub-level.</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Drill-down</run>
                              <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Expand any collection to explore the full hierarchy — GUID Prefix → Kingdom → Phylum → Class → Order → Family → Genus → Species.</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Sorting</run>
                              <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Each level is sorted by record count, highest to lowest.</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Filters</run>
                              <run fontcolor='#34528f' fontname='Arial' fontsize='15'>: Use the right-side panel to filter by GUID Prefix, Collection, Kingdom, Phylum, Phylclass, Phylorder, and Genus.</run>
                            </formatted-text>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                        </zone>
                      </zone>
                      <zone fixed-size='362' h='18100' id='179' is-fixed='true' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='91025' x='8340' y='63800'>
                        <zone fixed-size='157' forceUpdate='true' h='9050' id='181' is-fixed='true' type-v2='text' w='91025' x='8340' y='63800'>
                          <formatted-text>
                            <run bold='true' fontcolor='#34528f' fontname='Tableau Regular' fontsize='26'>HOW TO USE THIS DASHBOARD</run>
                            <run>Æ&#10;&#10;</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='15'>Each tab is self-contained with its own filter panel on the right. Hover over any bar or mark to see detailed counts in a tooltip. Click elements to cross-filter across the view.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Downloading: </run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='15'>In the top-right corner of any dashboard tab, click the </run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='15'>Download</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='15'> button. Select your preferred format from the dropdown — Image, Crosstab, PDF, PowerPoint, or Tableau Workbook.</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                        <zone h='9050' id='363' param='horz' type-v2='layout-flow' w='91025' x='8340' y='72850' />
                      </zone>
                      <zone fixed-size='44' forceUpdate='true' h='2600' id='192' is-fixed='true' type-v2='text' w='91025' x='8340' y='81900'>
                        <formatted-text>
                          <run bold='true' fontcolor='#34528f' fontname='Tableau Regular' fontsize='26'>ABOUT THIS PROJECT</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='10' h='500' id='195' is-fixed='true' param='vert' type-v2='layout-flow' w='91025' x='8340' y='84500' />
                      <zone fixed-size='292' h='14600' id='196' is-fixed='true' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='91025' x='8340' y='85000'>
                        <zone fixed-size='160' forceUpdate='true' h='14600' id='154' is-fixed='true' type-v2='text' w='91025' x='8340' y='85000'>
                          <formatted-text>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Developed by the UC Davis MSBA Practicum team (2025-2026) for the Arctos Consortium / Museum of Vertebrate Zoology.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Authors: </run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Abdurrahman Kazi, Qianying Yang</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Academic Advisor: </run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Michelle S. Koo</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#34528f' fontname='Arial' fontsize='16'>Client: </run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Arctos Consortium</run>
                            <run>Æ&#10;&#10;</run>
                            <run fontcolor='#34528f' fontname='Arial' fontsize='16'>Deliverables: Tableau Dashboard · AI-Powered Querybot · Automated Update Pipeline · Documentation</run>
                            <run>Æ&#10;&#10;</run>
                            <run auto-url='true' fontcolor='#34528f' fontname='Arial' fontsize='16' hyperlink='tabdoc:load-url url=&amp;quot;https://arctos.database.museum&amp;quot;'>https://arctos.database.museum</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                      </zone>
                    </zone>
                  </zone>
                  <zone h='95376' id='142' param='vert' type-v2='layout-flow' w='7705' x='635' y='4224'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
